# Rendered by the nginx image's envsubst step (only ${VARS} that exist in the env are replaced).
map $http_upgrade $connection_upgrade { default upgrade; '' close; }

# Docker's embedded DNS. Re-resolve `api` every 10s so a recreated or rescaled api container
# (new IP) is picked up without restarting nginx. A static proxy_pass host is resolved once, forever.
resolver 127.0.0.11 valid=10s ipv6=off;

server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  server_tokens off;

  gzip on;
  gzip_comp_level 5;
  gzip_min_length 1024;
  gzip_types text/css application/javascript application/json image/svg+xml;

  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  # SAMEORIGIN so the app can show its own PDFs in an <iframe> (the browser PDF viewer); nobody else can frame it.
  add_header X-Frame-Options SAMEORIGIN always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.googleusercontent.com; font-src 'self'; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'" always;

  # API (and signed media) → api service. Uploads stream straight through.
  location /api/ {
    set $api_upstream http://${API_UPSTREAM};
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    client_max_body_size ${MAX_BODY_SIZE};
    proxy_request_buffering off;
    proxy_read_timeout 300s;
  }

  # Hashed build assets never change.
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  # The app shell must always be fresh.
  location = /index.html { add_header Cache-Control "no-cache" always; }

  location / { try_files $uri /index.html; }
}
