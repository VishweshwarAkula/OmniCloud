# ─── Copy to .env (or run `make env`). Never commit .env. ───────────────────────

# `autoscale` runs the queue-driven autoscaler (needs the Docker socket via a locked-down proxy).
# Remove it to run a fixed single worker instead.
COMPOSE_PROFILES=autoscale

# Browser-facing URL. Google redirect URIs are built from it:
#   sign-in:        ${PUBLIC_URL}/api/auth/google/callback
#   Drive connect:  ${PUBLIC_URL}/api/oauth/gdrive/callback
#   Dropbox:        ${PUBLIC_URL}/api/oauth/dropbox/callback
#   prod compose: http://localhost:8080      dev compose: http://localhost:5173
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080

# Where Postgres/Redis/Weaviate data, uploads and the local-disk library are stored (bind mounts).
DATA_DIR=./.data

# ─── Local Postgres (container) ───
POSTGRES_PASSWORD=

# ─── Secrets generated by `make env` ───  (openssl rand -hex 32)
TOKEN_ENC_KEY=
URL_SIGNING_SECRET=
ML_SERVICE_TOKEN=

# ─── Sign-in ───
# Google OAuth client (used for both sign-in and Drive access).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local-only email sign-in without Google. Handy for trying the app; never enable on a shared host.
DEV_LOGIN=false

# ─── Dropbox (optional) ───
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=

# ─── Gemini receipt OCR (optional; OCR is skipped when empty) ───
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ─── Vision model (baked into the ml image; after changing: make up && make reindex) ───
# ViT-B-16-SigLIP2-256  balanced default (CPU friendly)
# ViT-L-16-SigLIP2-256  higher accuracy, ~3x slower, ~3.5 GB RAM per ml replica
EMBED_MODEL_NAME=ViT-B-16-SigLIP2-256
EMBED_MODEL_PRETRAIN=webli
# Zero-shot tag threshold (calibrated SigLIP probability) and hybrid search weighting.
TAG_MIN_PROB=0.08
SEARCH_ALPHA=0.75
# Relevance cutoff: similarity margin over a generic caption (higher = stricter).
SEARCH_MIN_MARGIN=0.015
# CPU threads per ml replica (replicas × threads ≈ cores works best).
TORCH_THREADS=4

# ─── Places / faces / query understanding / re-ranking ───
# Each *_MODE: auto (API when configured, else local) | api | local. API errors always fall back to local.
# Places: the API is OpenStreetMap Nominatim. It's off unless you set a URL, because it sends photo GPS
# coordinates to a third party (public server: https://nominatim.openstreetmap.org, ~1 req/s).
GEOCODER_MODE=auto
NOMINATIM_URL=
# Query understanding and re-ranking use Gemini when GOOGLE_API_KEY is set.
UNDERSTAND_MODE=auto
RERANK_MODE=auto
RERANK_TOP_N=12
# Faces are always local (biometric data stays on this machine): local | off
FACES_MODE=local
FACE_MATCH_THRESHOLD=0.42

# ─── Pipeline tuning (per worker replica) ───
UPLOAD_CONCURRENCY=6
EMBED_CONCURRENCY=2
OCR_CONCURRENCY=4
FINALIZE_CONCURRENCY=8
OCR_RATE_PER_MINUTE=60
MAX_QUEUE_BACKLOG=5000
MAX_UPLOAD_MB=25

# ─── Autoscaler ───
# replicas = clamp(ceil(queued jobs / TARGET), MIN, MAX)
WORKER_MIN=1
WORKER_MAX=8
WORKER_TARGET_BACKLOG=20
ML_MIN=1
ML_MAX=3
ML_TARGET_BACKLOG=10
SCALE_DOWN_DELAY_MS=90000

LOG_LEVEL=info
