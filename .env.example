# ─── Copy to .env (or run `make env`). Never commit .env. ───────────────────────

# `autoscale` runs the queue-driven autoscaler (needs the Docker socket via a locked-down proxy).
# Remove it to run a fixed single worker instead.
COMPOSE_PROFILES=autoscale

# Browser-facing URL. OAuth redirect URIs are built from it: ${PUBLIC_URL}/api/oauth/{gdrive|dropbox|pcloud}/callback
#   prod compose: http://localhost:8080      dev compose: http://localhost:5173
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080
# Single-user app (no login, reachable from this computer only). Whose library to show; defaults to the oldest account.
OWNER_EMAIL=

# Where Postgres/Redis/Weaviate data and in-flight uploads are stored (bind mounts).
DATA_DIR=./.data

# ─── Local Postgres (container) ───
POSTGRES_PASSWORD=

# ─── Secrets generated by `make env` ───  (openssl rand -hex 32)
TOKEN_ENC_KEY=
URL_SIGNING_SECRET=
ML_SERVICE_TOKEN=

# ─── Google Drive (optional) ───
# OAuth client for connecting Google Drive.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Dropbox (optional) ───
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=

# ─── pCloud (optional, 10 GB free) ───  app at https://docs.pcloud.com → My applications
# Redirect URI: ${PUBLIC_URL}/api/oauth/pcloud/callback
PCLOUD_CLIENT_ID=
PCLOUD_CLIENT_SECRET=
# Koofr (10 GB free) needs nothing here: connect it in Settings with an app password.

# ─── Gemini (optional): smarter query understanding + visual re-ranking ───
# After changing anything in this file, run `docker compose up -d`: env is read when a container is created.
GOOGLE_API_KEY=

# ─── Vision model (baked into the ml image; after changing: make up && make reindex) ───
# ViT-B-16-SigLIP2-256  balanced default (CPU friendly)
# ViT-L-16-SigLIP2-256  higher accuracy, ~3x slower, ~3.5 GB RAM per ml replica
EMBED_MODEL_NAME=ViT-B-16-SigLIP2-256
EMBED_MODEL_PRETRAIN=webli
# Zero-shot tag threshold (calibrated SigLIP probability) and hybrid search weighting.
TAG_MIN_PROB=0.08
SEARCH_ALPHA=0.75
# Relevance cutoff: similarity margin over a generic caption (higher = stricter).
SEARCH_MIN_MARGIN=0.015
# Document relevance cutoff (e5 cosine). Measured: right matches 0.84-0.90, unrelated text <= 0.79.
DOC_MIN_COS=0.82
# CPU threads per ml replica (replicas × threads ≈ cores works best).
TORCH_THREADS=4

# ─── Places / faces / query understanding / re-ranking ───
# Each *_MODE: auto (API when configured, else local) | api | local. API errors always fall back to local.
# Places: the API is OpenStreetMap Nominatim. It's off unless you set a URL, because it sends photo GPS
# coordinates to a third party (public server: https://nominatim.openstreetmap.org, ~1 req/s).
GEOCODER_MODE=auto
NOMINATIM_URL=
# Query understanding runs on this machine: rules (dates) + a 4-bit Qwen3-0.6B via llama.cpp (~1 s,
# typos/other languages/paraphrase). llm | rules | api (Gemini, needs GOOGLE_API_KEY). Cached a day.
UNDERSTAND_MODE=llm
UNDERSTAND_MODEL=gemini-2.5-flash-lite
# Re-ranking: local (default, offline: SigLIP + MMR) | api (Gemini vision; sends the top thumbnails to
# Google, needs GOOGLE_API_KEY) | auto (api when a key is set).
RERANK_MODE=local
RERANK_MODEL=gemini-2.5-flash-lite
RERANK_TOP_N=12
# Faces are always local (biometric data stays on this machine): local | off
FACES_MODE=local
FACE_MATCH_THRESHOLD=0.42

# ─── Pipeline tuning (per worker replica) ───
UPLOAD_CONCURRENCY=6
EMBED_CONCURRENCY=2
FINALIZE_CONCURRENCY=8
MAX_QUEUE_BACKLOG=5000
MAX_UPLOAD_MB=25

# ─── Autoscaler ───
# replicas = clamp(ceil(queued jobs / TARGET), MIN, MAX)
WORKER_MIN=1
WORKER_MAX=8
WORKER_TARGET_BACKLOG=20
ML_MIN=1
ML_MAX=3
ML_TARGET_BACKLOG=10
SCALE_DOWN_DELAY_MS=90000

LOG_LEVEL=info
